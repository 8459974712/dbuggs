<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Banner & Offers – Dbuggs Admin</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --navy:#1C2B6B;--accent:#F07830;--accent-hover:#d96820;
  --bg:#EFF1F8;--card:#FFFFFF;--text-primary:#1a1f36;--text-secondary:#6b7280;
  --text-muted:#9ca3af;--border:#e5e7eb;--success:#10b981;--warning:#f59e0b;
  --danger:#ef4444;--info:#3b82f6;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text-primary);display:flex;min-height:100vh;font-size:14px;}
h1,h2,h3,h4,h5{font-family:'Space Grotesk',sans-serif;}

/* ── SLIDE TABS ── */
.slide-tabs{display:flex;gap:6px;margin-bottom:18px;}
.slide-tab{padding:7px 18px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;border:1.5px solid var(--border);background:var(--bg);color:var(--text-secondary);transition:all .15s;font-family:'DM Sans',sans-serif;}
.slide-tab.active{background:var(--accent);color:#fff;border-color:var(--accent);}
.slide-tab:hover:not(.active){background:var(--card);color:var(--text-primary);}
.slide-empty-note{font-size:12px;color:var(--text-muted);margin-top:-10px;margin-bottom:14px;}

/* ── MAIN ── */
.main{margin-left:240px;flex:1;display:flex;flex-direction:column;min-width:0;}
.topbar{background:var(--card);border-bottom:1px solid var(--border);padding:0 28px;height:60px;display:flex;align-items:center;gap:16px;position:sticky;top:0;z-index:50;}
.topbar-title{font-family:'Space Grotesk',sans-serif;font-size:18px;font-weight:700;color:var(--text-primary);}
.topbar-spacer{flex:1;}
.topbar-icon-btn{width:36px;height:36px;border-radius:8px;border:1px solid var(--border);background:var(--bg);display:flex;align-items:center;justify-content:center;cursor:pointer;position:relative;color:var(--text-secondary);}
.notif-dot{position:absolute;top:6px;right:6px;width:7px;height:7px;border-radius:50%;background:var(--accent);border:1.5px solid var(--card);}
.topbar-avatar{width:36px;height:36px;border-radius:50%;background:var(--accent);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;color:#fff;cursor:pointer;}
.content{padding:28px;flex:1;}
.page-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;}
.page-header h2{font-size:22px;font-weight:700;}
.super-badge{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;background:#fef3c7;border:1.5px solid #f59e0b;border-radius:8px;font-size:13.5px;font-weight:700;color:#92400e;}

/* ── CARDS ── */
.card{background:var(--card);border-radius:12px;border:1px solid var(--border);box-shadow:0 1px 3px rgba(0,0,0,.07);margin-bottom:20px;}
.card-header{padding:16px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;}
.card-title{font-family:'Space Grotesk',sans-serif;font-size:15px;font-weight:600;}
.card-body{padding:20px;}
.form-group{margin-bottom:14px;}
.form-group label{display:block;font-size:12px;font-weight:600;color:var(--text-secondary);margin-bottom:5px;text-transform:uppercase;letter-spacing:.04em;}
.form-group input,.form-group select,.form-group textarea{width:100%;padding:9px 12px;border:1.5px solid var(--border);border-radius:8px;font-size:13px;font-family:'DM Sans',sans-serif;color:var(--text-primary);background:var(--bg);outline:none;transition:border .15s;}
.form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:var(--accent);}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.form-row-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;}
.small-note{font-size:11.5px;color:var(--text-muted);margin-top:4px;}
.btn{display:inline-flex;align-items:center;gap:7px;padding:9px 18px;border-radius:8px;font-family:'DM Sans',sans-serif;font-size:13.5px;font-weight:600;cursor:pointer;border:none;transition:all .15s;text-decoration:none;}
.btn-primary{background:var(--accent);color:#fff;}.btn-primary:hover{background:var(--accent-hover);}
.btn-outline{background:var(--card);color:var(--text-primary);border:1px solid var(--border);}.btn-outline:hover{background:var(--bg);}
.btn-danger{background:#fee2e2;color:#991b1b;border:1px solid #fca5a5;}.btn-danger:hover{background:#fca5a5;}

/* ── PREVIEW ── */
.preview-wrap{background:#f1f3f6;border-radius:10px;padding:12px;border:1px solid var(--border);margin-bottom:20px;}
.preview-label{font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px;}
.hero-preview{display:grid;grid-template-columns:2fr 1fr;gap:10px;max-width:700px;}
.hero-main-prev{background:linear-gradient(120deg,#0f4c9b 0%,#1a73e8 60%,#2874f0 100%);border-radius:6px;padding:24px 22px;color:#fff;position:relative;overflow:hidden;min-height:120px;background-size:cover;background-position:center;}
.hero-main-prev::after{content:'';position:absolute;inset:0;background:rgba(0,0,0,.35);border-radius:6px;pointer-events:none;}
.hero-main-prev .content-layer{position:relative;z-index:1;}
.hero-prev-h1{font-size:17px;font-weight:700;line-height:1.25;margin-bottom:6px;}
.hero-prev-p{font-size:12px;opacity:.9;margin-bottom:12px;}
.hero-prev-cta{display:inline-block;background:#ffe500;color:#212121;font-weight:700;padding:5px 14px;border-radius:3px;font-size:11px;}
.hero-side-prev{display:flex;flex-direction:column;gap:8px;}
.side-card-prev{border-radius:5px;padding:12px;color:#fff;font-size:12px;}
.side-card-orange{background:#e65c00;}
.side-card-teal{background:#00796b;}
.side-prev-tag{font-size:9px;font-weight:700;background:rgba(255,255,255,.25);padding:1px 6px;border-radius:10px;display:inline-block;margin-bottom:4px;}
.side-prev-amt{font-size:16px;font-weight:700;margin-top:3px;}

/* ── UPLOAD ZONE ── */
.upload-zone{border:2px dashed var(--border);border-radius:10px;padding:24px;text-align:center;cursor:pointer;transition:border-color .2s,background .2s;background:var(--bg);}
.upload-zone:hover{border-color:var(--accent);background:#fff8f4;}
.upload-zone.has-img{border-color:var(--success);border-style:solid;background:#f0fdf4;}
.upload-zone input[type=file]{display:none;}
.upload-zone-icon{font-size:28px;margin-bottom:8px;}
.upload-zone p{font-size:13px;color:var(--text-secondary);}
.upload-zone small{font-size:11.5px;color:var(--text-muted);}
.img-preview-wrap{position:relative;display:inline-block;margin-top:10px;}
.img-preview-wrap img{max-height:100px;max-width:200px;border-radius:6px;border:1px solid var(--border);}
.remove-img{position:absolute;top:-6px;right:-6px;width:20px;height:20px;background:#ef4444;color:#fff;border-radius:50%;border:none;cursor:pointer;font-size:12px;display:flex;align-items:center;justify-content:center;font-weight:700;}

/* ── TOGGLE ── */
.toggle-wrap{display:flex;align-items:center;gap:10px;margin-bottom:14px;}
.toggle-wrap label{font-size:13.5px;font-weight:600;}
.toggle{position:relative;width:44px;height:24px;flex-shrink:0;}
.toggle input{display:none;}
.toggle-track{position:absolute;inset:0;background:#d1d5db;border-radius:12px;cursor:pointer;transition:background .2s;}
.toggle input:checked+.toggle-track{background:var(--success);}
.toggle-thumb{position:absolute;top:3px;left:3px;width:18px;height:18px;background:#fff;border-radius:50%;transition:transform .2s;pointer-events:none;}
.toggle input:checked~.toggle-thumb{transform:translateX(20px);}

/* ── SECTION BOX ── */
.section-box{background:var(--bg);border-radius:10px;padding:18px;border:1px solid var(--border);margin-bottom:16px;}
.section-box-title{font-size:13.5px;font-weight:700;margin-bottom:14px;display:flex;align-items:center;gap:8px;}
.badge-pill{font-size:11px;font-weight:700;padding:2px 10px;border-radius:20px;color:#fff;}
.pill-orange{background:#e65c00;}
.pill-teal{background:#00796b;}
.pill-blue{background:#2874f0;}

.save-msg{font-size:13px;padding:8px 14px;border-radius:6px;display:none;}
.save-msg.ok{background:#d1fae5;color:#065f46;display:block;}
.save-msg.err{background:#fee2e2;color:#991b1b;display:block;}

@media(max-width:900px){.hero-preview{grid-template-columns:1fr;}.form-row-3{grid-template-columns:1fr 1fr;}}
@media(max-width:640px){.sidebar{width:60px;}.main{margin-left:60px;}.content{padding:14px;}}
</style>
</head>
<body>

<!-- SIDEBAR -->
<style>
.dbugg-sidebar{width:240px;min-width:220px;background:#1C2B6B;display:flex;flex-direction:column;position:fixed;top:0;left:0;height:100vh;overflow-y:auto;z-index:1000;flex-shrink:0;}
.dbugg-sidebar::-webkit-scrollbar{width:4px;}
.dbugg-sidebar::-webkit-scrollbar-thumb{background:rgba(255,255,255,0.2);border-radius:4px;}
.dbugg-sidebar .sb-logo{padding:20px 20px 14px;border-bottom:1px solid rgba(255,255,255,0.08);}
.dbugg-sidebar .sb-brand{font-family:"Space Grotesk",sans-serif;font-size:20px;font-weight:700;color:#fff;}
.dbugg-sidebar .sb-brand span{color:#F07830;}
.dbugg-sidebar .sb-tagline{font-size:11px;color:rgba(255,255,255,0.5);margin-top:2px;}
.sb-nav{flex:1;padding:8px 0 16px;}
.sb-section-label{font-size:10px;font-weight:700;letter-spacing:0.1em;color:rgba(255,255,255,0.55);text-transform:uppercase;padding:14px 20px 5px;display:block!important;}
.sb-item{display:flex!important;align-items:center;gap:10px;padding:9px 20px;color:rgba(255,255,255,0.72);text-decoration:none;font-size:13.5px;font-weight:500;transition:background 0.15s,color 0.15s;border:none;background:none;width:100%;cursor:pointer;font-family:inherit;white-space:nowrap;}
.sb-item:hover{background:rgba(255,255,255,0.08);color:#fff;}
.sb-item.sb-active{background:rgba(240,120,48,0.18);color:#fff;border-right:3px solid #F07830;}
.sb-item svg{width:16px;height:16px;flex-shrink:0;opacity:0.8;}
.sb-item.sb-active svg{opacity:1;}
.sb-footer{padding:14px 20px;border-top:1px solid rgba(255,255,255,0.08);margin-top:auto;}
.sb-footer .sb-user{display:flex;align-items:center;gap:10px;}
.sb-footer .sb-avatar{width:34px;height:34px;border-radius:50%;background:#F07830;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;color:#fff;flex-shrink:0;}
.sb-footer .sb-name{font-size:13px;font-weight:600;color:#fff;}
.sb-footer .sb-role{font-size:11px;color:rgba(255,255,255,0.5);}
</style>
