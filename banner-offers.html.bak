  <a href="integrations.html" class="sb-item"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg>Integrations</a>
  <a href="audit-log.html" class="sb-item"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M13 3c-4.97 0-9 4.03-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"/></svg>Audit Log</a>
  <a href="banner-offers.html" class="sb-item sb-active"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M21 3H3c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H3V5h18v14zm-10-7h9v5h-9zm-4-3c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm3.75 3H2.85l2.9-3.65L7.65 14l2.1-2.64L12.25 14H6.75z"/></svg>Banner &amp; Offers</a>
  <a href="coupons.html" class="sb-item"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58s1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41s-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/></svg>Coupon Management</a>
  <a href="login-activity.html" class="sb-item"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 4l5 2.18V11c0 3.5-2.33 6.79-5 7.93-2.67-1.14-5-4.43-5-7.93V7.18L12 5z"/></svg>Login Activity &amp; IP</a>
</nav>
  <div class="sb-footer">
    <div class="sb-user">
      <div class="sb-avatar">SA</div>
      <div>
        <div class="sb-name">Super Admin</div>
        <div class="sb-role">admin@dbuggs.in</div>
      </div>
    </div>
  </div>
</aside>
<style>.main-wrapper,.main{margin-left:240px!important;}</style>

<!-- MAIN -->
<div class="main">
  <header class="topbar">
    <div class="topbar-title">Banner &amp; Offers</div>
    <div class="topbar-spacer"></div>
    <div class="topbar-icon-btn"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/></svg><div class="notif-dot"></div></div>
    <div class="topbar-avatar">SA</div>
  </header>

  <main class="content">
    <div class="page-header">
      <h2>Banner &amp; Offers</h2>
      <span class="super-badge">🖼 Homepage CMS</span>
    </div>

    <!-- LIVE PREVIEW -->
    <div class="card">
      <div class="card-header">
        <div class="card-title">Live Preview</div>
        <span style="font-size:12px;color:var(--text-muted);">Updates as you type</span>
      </div>
      <div class="card-body">
        <div class="hero-preview">
          <div class="hero-main-prev" id="prev-main">
            <div class="content-layer">
              <div class="hero-prev-h1" id="prev-h1">Certified Refurbished<br>Laptops. Up to 60% Off.</div>
              <div class="hero-prev-p" id="prev-p">Every unit QC tested, graded A+ to C, and backed by warranty.</div>
              <span class="hero-prev-cta" id="prev-cta">Shop Now →</span>
            </div>
          </div>
          <div class="hero-side-prev">
            <div class="side-card-prev side-card-orange" id="prev-card1" style="display:flex;flex-direction:column;">
              <span class="side-prev-tag" id="prev-c1-badge">LIMITED OFFER</span>
              <span id="prev-c1-title">Rent a Laptop</span>
              <span class="side-prev-amt" id="prev-c1-price">from ₹899/mo</span>
            </div>
            <div class="side-card-prev side-card-teal" id="prev-card2" style="display:flex;flex-direction:column;">
              <span class="side-prev-tag" id="prev-c2-badge">BULK PRICING</span>
              <span id="prev-c2-title">B2B / Corporate</span>
              <span class="side-prev-amt" id="prev-c2-price">Up to 18% off</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- HERO BANNER SLIDES -->
    <div class="card">
      <div class="card-header">
        <div class="card-title">🖼 Hero Banner Slides</div>
        <div style="font-size:12px;color:var(--text-muted);">Up to 3 slides — auto-carousel on homepage (4s interval)</div>
      </div>
      <div class="card-body">

        <!-- Slide tabs -->
        <div class="slide-tabs" id="slide-tabs">
          <button class="slide-tab active" onclick="switchSlide(0)">Slide 1</button>
          <button class="slide-tab" onclick="switchSlide(1)">Slide 2</button>
          <button class="slide-tab" onclick="switchSlide(2)">Slide 3</button>
        </div>
        <div class="slide-empty-note" id="slide-empty-note" style="display:none;">Leave headline empty to skip this slide on homepage.</div>

        <!-- Image Upload -->
        <div class="form-group">
          <label>Background Image <span style="color:var(--text-muted);font-weight:400;">(optional — JPG/PNG/WebP, max 3MB)</span></label>
          <div class="upload-zone" id="banner-upload-zone" onclick="document.getElementById('banner-img-input').click()">
            <input type="file" id="banner-img-input" accept=".jpg,.jpeg,.png,.webp" onchange="handleBannerImg(this)">
            <div id="banner-img-preview-wrap" style="display:none;" class="img-preview-wrap">
              <img id="banner-img-preview" src="" alt="Banner preview">
              <button class="remove-img" onclick="removeBannerImg(event)" title="Remove">×</button>
            </div>
            <div id="banner-upload-hint">
              <div class="upload-zone-icon">🖼</div>
              <p>Click to upload banner image</p>
              <small>JPG · PNG · WebP · Max 3 MB &nbsp;|&nbsp; Recommended: 900×200px</small>
            </div>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Headline</label>
            <input type="text" id="banner-headline" placeholder="Certified Refurbished Laptops. Up to 60% Off."
              oninput="onSlideInput()">
          </div>
          <div class="form-group">
            <label>Sub-headline</label>
            <input type="text" id="banner-subtext" placeholder="Every unit QC tested…"
              oninput="onSlideInput()">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Button Text</label>
            <input type="text" id="banner-cta-text" placeholder="Shop Now →"
              oninput="onSlideInput()">
          </div>
          <div class="form-group">
            <label>Button Link</label>
            <input type="text" id="banner-cta-link" placeholder="#products or /category.html">
          </div>
        </div>
      </div>
    </div>

    <!-- OFFER CARDS SETTINGS -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">

      <!-- CARD 1 — ORANGE -->
      <div class="card">
        <div class="card-header">
          <div class="card-title">🟠 Offer Card 1 — Orange</div>
        </div>
        <div class="card-body">
          <div class="toggle-wrap">
            <label class="toggle">
              <input type="checkbox" id="c1-enabled" checked onchange="toggleCard(1,this.checked)">
              <div class="toggle-track"></div>
              <div class="toggle-thumb"></div>
            </label>
            <label for="c1-enabled" style="cursor:pointer;">Show this card on homepage</label>
          </div>
          <div id="c1-fields">
            <div class="form-group">
              <label>Badge Label</label>
              <input type="text" id="c1-badge" value="LIMITED OFFER"
                oninput="document.getElementById('prev-c1-badge').textContent=this.value">
            </div>
            <div class="form-group">
              <label>Title</label>
              <input type="text" id="c1-title" value="Rent a Laptop"
                oninput="document.getElementById('prev-c1-title').textContent=this.value">
            </div>
            <div class="form-group">
              <label>Price / Subtitle</label>
              <input type="text" id="c1-price" value="from ₹899/mo"
                oninput="document.getElementById('prev-c1-price').textContent=this.value">
            </div>
            <div class="form-group">
              <label>Click Link</label>
              <input type="text" id="c1-link" value="/rental-checkout.html" placeholder="/rental-checkout.html">
            </div>
          </div>
        </div>
      </div>

      <!-- CARD 2 — TEAL -->
      <div class="card">
        <div class="card-header">
          <div class="card-title">🟢 Offer Card 2 — Teal</div>
        </div>
        <div class="card-body">
          <div class="toggle-wrap">
            <label class="toggle">
              <input type="checkbox" id="c2-enabled" checked onchange="toggleCard(2,this.checked)">
              <div class="toggle-track"></div>
              <div class="toggle-thumb"></div>
            </label>
            <label for="c2-enabled" style="cursor:pointer;">Show this card on homepage</label>
          </div>
          <div id="c2-fields">
            <div class="form-group">
              <label>Badge Label</label>
              <input type="text" id="c2-badge" value="BULK PRICING"
                oninput="document.getElementById('prev-c2-badge').textContent=this.value">
            </div>
            <div class="form-group">
              <label>Title</label>
              <input type="text" id="c2-title" value="B2B / Corporate"
                oninput="document.getElementById('prev-c2-title').textContent=this.value">
            </div>
            <div class="form-group">
              <label>Price / Subtitle</label>
              <input type="text" id="c2-price" value="Up to 18% off"
                oninput="document.getElementById('prev-c2-price').textContent=this.value">
            </div>
            <div class="form-group">
              <label>Click Link</label>
              <input type="text" id="c2-link" value="/b2b-register.html" placeholder="/b2b-register.html">
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TRUST BAR SETTINGS (bonus) -->
    <div class="card" style="margin-top:20px;">
      <div class="card-header">
        <div class="card-title">✅ Trust Bar Icons <span style="font-size:12px;color:var(--text-muted);font-weight:400;">(below the hero)</span></div>
      </div>
      <div class="card-body">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;" id="trust-items">
          <div class="form-group"><label>Item 1</label><input type="text" class="trust-item" value="🛡 12 Month Warranty"></div>
          <div class="form-group"><label>Item 2</label><input type="text" class="trust-item" value="✅ 45-Point QC Check"></div>
          <div class="form-group"><label>Item 3</label><input type="text" class="trust-item" value="🚚 Free Shipping"></div>
          <div class="form-group"><label>Item 4</label><input type="text" class="trust-item" value="🔄 7-Day Easy Returns"></div>
          <div class="form-group"><label>Item 5</label><input type="text" class="trust-item" value="💳 Secure Payments"></div>
          <div class="form-group"><label>Item 6 <span style="color:var(--text-muted);font-weight:400;">(optional)</span></label><input type="text" class="trust-item" value=""></div>
        </div>
      </div>
    </div>

    <!-- SAVE -->
    <div style="display:flex;align-items:center;gap:14px;margin-top:24px;flex-wrap:wrap;">
      <button class="btn btn-primary" onclick="saveBannerSettings()" style="font-size:15px;padding:11px 28px;">
        💾 Save &amp; Publish to Homepage
      </button>
      <button class="btn btn-outline" onclick="resetToDefaults()">↺ Reset to Defaults</button>
      <div id="save-msg" class="save-msg"></div>
    </div>

    <div style="margin-top:16px;background:#ecfdf5;border:1px solid #10b981;border-radius:8px;padding:12px 16px;font-size:13px;color:#065f46;">
      <strong>How it works:</strong> Clicking "Save &amp; Publish" sends the banner settings directly to the VPS API server, which updates the homepage instantly — no browser refresh tricks needed.
    </div>

  </main>
</div>

<script>
const VPS_API = 'http://200.234.39.146:3999/api/banner';

/* ── SLIDE DATA ── */
let currentSlide = 0;
let slideData = [
  { headline: 'Certified Refurbished Laptops. Up to 60% Off.', subtext: 'Every unit QC tested, graded A+ to C, and backed by warranty. Buy, rent, or source in bulk.', ctaText: 'Shop Now →', ctaLink: '#products', bannerImg: null },
  { headline: '', subtext: '', ctaText: 'Shop Now →', ctaLink: '#products', bannerImg: null },
  { headline: '', subtext: '', ctaText: 'Shop Now →', ctaLink: '#products', bannerImg: null },
];

/* ── SLIDE SWITCHING ── */
function switchSlide(idx) {
  saveCurrentSlideToData();
  currentSlide = idx;
  document.querySelectorAll('.slide-tab').forEach((t,i) => t.classList.toggle('active', i===idx));
  document.getElementById('slide-empty-note').style.display = idx > 0 ? '' : 'none';
  loadSlideToForm(slideData[idx]);
}

function saveCurrentSlideToData() {
  slideData[currentSlide] = {
    headline:  document.getElementById('banner-headline').value,
    subtext:   document.getElementById('banner-subtext').value,
    ctaText:   document.getElementById('banner-cta-text').value,
    ctaLink:   document.getElementById('banner-cta-link').value,
    bannerImg: bannerImgData,
  };
}

function loadSlideToForm(s) {
  document.getElementById('banner-headline').value  = s.headline  || '';
  document.getElementById('banner-subtext').value   = s.subtext   || '';
  document.getElementById('banner-cta-text').value  = s.ctaText   || 'Shop Now →';
  document.getElementById('banner-cta-link').value  = s.ctaLink   || '#products';
  bannerImgData = s.bannerImg || null;
  updatePreviewFromSlide(s);
  if (s.bannerImg) {
    showImgPreview(s.bannerImg);
    document.getElementById('prev-main').style.backgroundImage = `url(${s.bannerImg})`;
  } else {
    bannerImgData = null;
    document.getElementById('banner-img-input').value = '';
    document.getElementById('banner-img-preview-wrap').style.display = 'none';
    document.getElementById('banner-upload-hint').style.display = 'block';
    document.getElementById('banner-upload-zone').classList.remove('has-img');
    document.getElementById('prev-main').style.backgroundImage = '';
  }
}

function onSlideInput() {
  const h = document.getElementById('banner-headline').value;
  const p = document.getElementById('banner-subtext').value;
  const c = document.getElementById('banner-cta-text').value;
  document.getElementById('prev-h1').textContent  = h || 'Headline here';
  document.getElementById('prev-p').textContent   = p;
  document.getElementById('prev-cta').textContent = c || 'Shop Now →';
}

function updatePreviewFromSlide(s) {
  document.getElementById('prev-h1').textContent  = s.headline  || 'Headline here';
  document.getElementById('prev-p').textContent   = s.subtext   || '';
  document.getElementById('prev-cta').textContent = s.ctaText   || 'Shop Now →';
}

/* ── IMAGE UPLOAD ── */
let bannerImgData = null;

function handleBannerImg(input) {
  const file = input.files[0];
  if (!file) return;
  if (!['image/jpeg','image/png','image/webp'].includes(file.type)) {
    alert('Only JPG, PNG or WebP allowed.'); input.value=''; return;
  }
  if (file.size > 3 * 1024 * 1024) {
    alert('Image must be under 3 MB.'); input.value=''; return;
  }
  const reader = new FileReader();
  reader.onload = e => {
    bannerImgData = e.target.result;
    slideData[currentSlide].bannerImg = bannerImgData;
    showImgPreview(bannerImgData);
    document.getElementById('prev-main').style.backgroundImage = `url(${bannerImgData})`;
    document.getElementById('banner-upload-zone').classList.add('has-img');
  };
  reader.readAsDataURL(file);
}

function showImgPreview(src) {
  document.getElementById('banner-img-preview').src = src;
  document.getElementById('banner-upload-hint').style.display = 'none';
  document.getElementById('banner-img-preview-wrap').style.display = 'inline-block';
  document.getElementById('banner-upload-zone').classList.add('has-img');
}

function removeBannerImg(e) {
  e.stopPropagation();
  bannerImgData = null;
  slideData[currentSlide].bannerImg = null;
  document.getElementById('banner-img-input').value = '';
  document.getElementById('banner-img-preview-wrap').style.display = 'none';
  document.getElementById('banner-upload-hint').style.display = 'block';
  document.getElementById('banner-upload-zone').classList.remove('has-img');
  document.getElementById('prev-main').style.backgroundImage = '';
}

/* ── CARD TOGGLE ── */
function toggleCard(n, enabled) {
  const prev   = document.getElementById(`prev-card${n}`);
  const fields = document.getElementById(`c${n}-fields`);
  prev.style.display         = enabled ? 'flex' : 'none';
  fields.style.opacity       = enabled ? '1' : '0.4';
  fields.style.pointerEvents = enabled ? '' : 'none';
}

/* ── SAVE & PUBLISH ── */
async function saveBannerSettings() {
  saveCurrentSlideToData();

  const trustInputs = document.querySelectorAll('.trust-item');
  const activeSlides = slideData.filter(s => s.headline || s.bannerImg);

  const settings = {
    slides: activeSlides.length ? activeSlides : [slideData[0]],
    // keep flat fields for backward compat
    headline:  slideData[0].headline,
    subtext:   slideData[0].subtext,
    ctaText:   slideData[0].ctaText,
    ctaLink:   slideData[0].ctaLink,
    bannerImg: slideData[0].bannerImg,
    c1: {
      enabled: document.getElementById('c1-enabled').checked,
      badge:   document.getElementById('c1-badge').value,
      title:   document.getElementById('c1-title').value,
      price:   document.getElementById('c1-price').value,
      link:    document.getElementById('c1-link').value,
    },
    c2: {
      enabled: document.getElementById('c2-enabled').checked,
      badge:   document.getElementById('c2-badge').value,
      title:   document.getElementById('c2-title').value,
      price:   document.getElementById('c2-price').value,
      link:    document.getElementById('c2-link').value,
    },
    trust: Array.from(trustInputs).map(i => i.value).filter(v => v.trim()),
  };

  const btn = document.querySelector('.btn-primary');
  btn.textContent = 'Publishing…';
  btn.disabled = true;

  // POST to VPS API — this updates homepage directly
  try {
    const resp = await fetch(VPS_API, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(settings),
    });
    if (resp.ok) {
      showMsg('✅ Published! Homepage updated instantly.', 'ok');
    } else {
      showMsg('⚠️ API error — check if banner-api.py is running on VPS.', 'err');
    }
  } catch(e) {
    showMsg('⚠️ Cannot reach VPS API (port 3999). Deploy banner-api.py first.', 'err');
  }

  btn.textContent = '💾 Save & Publish to Homepage';
  btn.disabled = false;
}

function resetToDefaults() {
  if (!confirm('Reset all banner settings to defaults?')) return;
  slideData = [
    { headline: 'Certified Refurbished Laptops. Up to 60% Off.', subtext: 'Every unit QC tested, graded A+ to C, and backed by warranty.', ctaText: 'Shop Now →', ctaLink: '#products', bannerImg: null },
    { headline: '', subtext: '', ctaText: 'Shop Now →', ctaLink: '#products', bannerImg: null },
    { headline: '', subtext: '', ctaText: 'Shop Now →', ctaLink: '#products', bannerImg: null },
  ];
  currentSlide = 0;
  document.querySelectorAll('.slide-tab').forEach((t,i) => t.classList.toggle('active', i===0));
  loadSlideToForm(slideData[0]);
  showMsg('Reset to defaults.', 'ok');
}

function showMsg(text, type) {
  const el = document.getElementById('save-msg');
  el.textContent = text;
  el.className = 'save-msg ' + type;
  setTimeout(() => { el.className = 'save-msg'; }, 5000);
}

/* ── LOAD EXISTING SETTINGS ── */
async function loadSettings() {
  try {
    // Try fetching current banner-config.json from VPS
    const resp = await fetch('http://200.234.39.146/banner-config.json?' + Date.now()).catch(() => null);
    let s = resp && resp.ok ? await resp.json().catch(() => null) : null;
    if (!s) {
      // fallback: try the web container directly
      const r2 = await fetch('http://200.234.39.146:5001/banner-config.json?' + Date.now()).catch(() => null);
      s = r2 && r2.ok ? await r2.json().catch(() => null) : null;
    }
    if (s) applySettings(s);
  } catch(e) {}
}

function applySettings(s) {
  // Load slides
  if (s.slides && s.slides.length) {
    s.slides.forEach((sl, i) => { if (i < 3) slideData[i] = { ...slideData[i], ...sl }; });
  } else if (s.headline) {
    slideData[0] = { headline: s.headline || slideData[0].headline, subtext: s.subtext || slideData[0].subtext, ctaText: s.ctaText || slideData[0].ctaText, ctaLink: s.ctaLink || slideData[0].ctaLink, bannerImg: s.bannerImg || null };
  }
  loadSlideToForm(slideData[0]);

  // card 1
  if (s.c1) {
    document.getElementById('c1-enabled').checked = s.c1.enabled !== false;
    toggleCard(1, s.c1.enabled !== false);
    if (s.c1.badge) { document.getElementById('c1-badge').value = s.c1.badge; document.getElementById('prev-c1-badge').textContent = s.c1.badge; }
    if (s.c1.title) { document.getElementById('c1-title').value = s.c1.title; document.getElementById('prev-c1-title').textContent = s.c1.title; }
    if (s.c1.price) { document.getElementById('c1-price').value = s.c1.price; document.getElementById('prev-c1-price').textContent = s.c1.price; }
    if (s.c1.link)    document.getElementById('c1-link').value  = s.c1.link;
  }
  // card 2
  if (s.c2) {
    document.getElementById('c2-enabled').checked = s.c2.enabled !== false;
    toggleCard(2, s.c2.enabled !== false);
    if (s.c2.badge) { document.getElementById('c2-badge').value = s.c2.badge; document.getElementById('prev-c2-badge').textContent = s.c2.badge; }
    if (s.c2.title) { document.getElementById('c2-title').value = s.c2.title; document.getElementById('prev-c2-title').textContent = s.c2.title; }
    if (s.c2.price) { document.getElementById('c2-price').value = s.c2.price; document.getElementById('prev-c2-price').textContent = s.c2.price; }
    if (s.c2.link)    document.getElementById('c2-link').value  = s.c2.link;
  }
  // trust
  if (s.trust && s.trust.length) {
    const inputs = document.querySelectorAll('.trust-item');
    s.trust.forEach((t,i) => { if (inputs[i]) inputs[i].value = t; });
  }
}

loadSettings();
</script>
</body>
</html>
